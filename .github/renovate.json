{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": [
        "config:recommended"
    ],
    "schedule": [
        "after 10pm on tuesday",
        "before 6am on wednesday"
    ],
    "rangeStrategy": "widen",
    "vulnerabilityAlerts": {
        "enabled": false
    },
    "osvVulnerabilityAlerts": false,
    "enabledManagers": [
        "pep621",
        "custom.regex"
    ],
    "pep621": {
        "managerFilePatterns": [
            "/(^|/)pyproject\\.toml$/"
        ]
    },
    "customManagers": [
        {
            "customType": "regex",
            "managerFilePatterns": [
                "/(^|/)requirements_dev\\.yml$/"
            ],
            "matchStrings": [
                "- (?<depName>[a-zA-Z0-9_.-]+)[^\\n]*?(?<currentValue><=\\d[^\\n,]*)"
            ],
            "packageNameTemplate": "conda-forge/{{{depName}}}",
            "datasourceTemplate": "conda",
            "versioningTemplate": "pep440"
        }
    ],
    "ignoreDeps": [
        "sphinx",
        "sphinx_rtd_theme",
        "myst-parser",
        "sphinx-rtd-theme",
        "ruff",
    ],
    "packageRules": [
        {
            "matchManagers": [
                "pep621",
                "custom.regex"
            ],
            "groupName": "{{depName}}"
        }
    ]
}