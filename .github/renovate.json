{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": [
        "config:recommended"
    ],
    "schedule": [
        "after 10pm on tuesday",
        "before 6am on wednesday"
    ],
    "rangeStrategy": "bump",
    "enabledManagers": [
        "pep621",
        "regex"
    ],
    "pep621": {
        "managerFilePatterns": [
            "/(^|/)pyproject\\.toml$/"
        ]
    },
    "customManagers": [
        {
            "customType": "regex",
            "managerFilePatterns": [
                "/(^|/)requirements_dev\\.yml$/"
            ],
            "matchStrings": [
                "- (?<depName>[a-zA-Z0-9_.-]+) (?<currentValue>[><=!][^\\n]*)"
            ],
            "packageNameTemplate": "conda-forge/{{{depName}}}",
            "datasourceTemplate": "conda",
            "versioningTemplate": "pep440"
        }
    ],
    "ignoreDeps": [
        "sphinx",
        "sphinx_rtd_theme",
        "myst-parser",
        "ruff",
        "nbval",
        "pytest-xdist",
        "pytest-cov",
        "pytest",
        "ipykernel",
        "gurobi-logtools"
    ],
    "packageRules": [
        {
            "matchManagers": [
                "pep621",
                "regex"
            ],
            "groupName": "{{depName}}"
        }
    ]
}